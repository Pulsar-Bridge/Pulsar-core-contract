root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
# Matches rustfmt's defaults (see CONTRIBUTING.md: `cargo fmt` is the
# source of truth for Rust files; this just keeps non-rustfmt-aware
# editors from fighting it before a save).
indent_size = 4
max_line_length = 100

[*.{yml,yaml,toml,md}]
indent_size = 2

[Makefile]
indent_style = tab
